{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe95",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GENERATOR", "class_name": "GenerationJob" },
      { "name": "CHAT", "class_name": "VibeRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GenerationJob"] },
    { "tag": "v2", "new_sqlite_classes": ["VibeRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibe95",
      "database_id": "0443eb26-e5e5-41ad-bf66-5afc6c9c97db"
    }
  ],
  // Email Sending binding. The sending domain mail.vibe95.net is onboarded
  // (DKIM/SPF/DMARC records are live in the vibe95.net zone). EMAIL_FROM must
  // stay on that domain — isConfiguredSender in worker/auth.ts gates the send
  // path, and sending from an unverified domain throws at logon time.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "EMAIL_FROM": "login@mail.vibe95.net",
    "APP_NAME": "Vibe95"
  }
}
