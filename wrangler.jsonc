{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe95",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GENERATOR", "class_name": "GenerationJob" },
      { "name": "CHAT", "class_name": "VibeRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GenerationJob"] },
    { "tag": "v2", "new_sqlite_classes": ["VibeRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibe95",
      "database_id": "0443eb26-e5e5-41ad-bf66-5afc6c9c97db"
    }
  ],
  // Email Sending binding. Disabled until a domain is onboarded via
  // `wrangler email sending enable <domain>`: declaring it against a domain
  // this account does not own makes OTP sending throw at logon time.
  // To enable: onboard the domain, set a real "EMAIL_FROM" below, then
  // uncomment the line. Until then OTPs go to the logs (`wrangler tail`).
  // "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "EMAIL_FROM": "login@vibe95.example.com",
    "APP_NAME": "Vibe95"
  }
}
